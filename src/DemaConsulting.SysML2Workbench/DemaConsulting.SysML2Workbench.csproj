<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DemaConsulting.SysML2Workbench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.14" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DemaConsulting.SysML2Tools.Core" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.SysML2Tools.Language" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.SysML2Tools.Stdlib" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.Rendering.Svg" Version="0.1.0" />

    <!-- Avalonia.Skia 12.1.1 pins older SkiaSharp native asset versions (e.g. Linux 3.119.4) than
         the SkiaSharp core version NuGet resolves to (4.148.0, pulled up by Svg.Controls.Skia.Avalonia's
         Svg.Skia dependency). Without these pins, restore leaves the non-Windows native asset packages
         behind at the older, incompatible version, causing SkiaSharp's native library version check to
         fail at runtime on Linux/macOS. Pinning all three platform packages to the same version as the
         resolved SkiaSharp core keeps them in lockstep. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.148.0" Condition="$([MSBuild]::IsOSPlatform('macOS'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEMA Consulting logo, sourced from the repository-root Icon.png, exposed for the
         window icon via avares://DemaConsulting.SysML2Workbench/Assets/Icon.png. -->
    <AvaloniaResource Include="..\..\Icon.png" Link="Assets\Icon.png" />

    <!-- Self-authored SysML v2 AvaloniaEdit syntax-highlighting definition, embedded so it can be
         loaded at runtime via avares://DemaConsulting.SysML2Workbench/Assets/SysML.xshd. -->
    <AvaloniaResource Include="Assets\SysML.xshd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal members (e.g. PathHelpers) to the test projects that exercise them
         directly, so tests can reuse the same reviewed helpers as production code.
         DemaConsulting.SysML2Workbench.IntegrationTests is deliberately excluded: it has no
         ProjectReference to this project (it drives the compiled app externally via Appium), so it
         carries its own copy of PathHelpers instead - see that project's PathHelpers.cs. -->
    <InternalsVisibleTo Include="DemaConsulting.SysML2Workbench.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.SysML2Workbench.UiTests" />
    <InternalsVisibleTo Include="OtsSoftwareTests" />
  </ItemGroup>

</Project>
